desc:REAPER Notator Auto-Divisi Live Input Router (v2.62)
// VERSION: 2.62
options:gmem=REAPER_Notator_Divisi

slider1:1<1,64,1>-Voice Rank (1=Highest .. M=Lowest)
slider2:1<1,64,1>-Total Armed Tracks (M)
slider3:0<0,2,1{Smart Register,Top-Down,Bottom-Up}>-Divisi Mode
slider4:45<5,240,1>-Transition Tolerance (Ticks)
slider5:1<0,1,1{Bypass,Active}>-Auto-Divisi Enabled
slider6:0<0,1,1{Normal Divisi,Full Ensemble Fill}>-Fill All Armed Tracks
slider7:0<0,64,1>-Telemetry Slot Index (0=Off, 1..64)
slider8:0<0,127,1>-Track Playable Min Pitch
slider9:127<0,127,1>-Track Playable Max Pitch
slider10:1<0,1,1{Elastic Compass,Strict Playable Compass}>-Instrument Range Enforcement

@init
STRIDE = 66;
INF_COST = 9000000000.0;
UNPLAYABLE_COST = 2000000000.0;
VALID_LIMIT = 900000000.0;

kb_held = 0;            // 0..127
kb_vel = 128;           // 128..255
kb_chan = 256;          // 256..383
kb_onset = 384;         // 384..511
primary_rank = 512;     // 512..639
my_sounding = 640;      // 640..767
my_sounding_chan = 768; // 768..895
preempted_rank = 896;   // 896..1023
cluster_notes = 1024;   // 1024..1151
cluster_is_held = 1152; // 1152..1279
is_sustained = 1280;    // 1280..1349
sust_pitch = 1350;      // 1350..1419
is_legato_tail = 1420;  // 1420..1547
chosen_slot = 1550;     // 1550..1619
elig_ranks = 1620;      // 1620..1689
used_rank_tmp = 1700;   // 1700..1769
dp = 2000;              // 2000..6355 (66 * 66)
parent = 6400;          // 6400..10755 (66 * 66)
assigned_map = 10800;   // 10800..19247 (128 * 66)
is_fill_map = 19300;    // 19300..27747 (128 * 66)
prev_assigned = 27800;  // 27800..32155 (66 * 66)
was_assigned = 32200;   // 32200..40647 (128 * 66)

running_samples = 0;
prev_single_k = 0;
prev_single_pitch = -1;
prev_single_sample = -1000000;
gliss_dir = 0;
prev_melody_pitch = -1;
prev_melody_sample = -10000000;
last_fast_melody_sample = -10000000;
gmem[1007] = 262;

function emit_midi(offset, m1, m2, m3) local(rb_base, cur_tok, wseq, ent, ev_qn) (
  midisend(offset, m1, m2, m3);
  (slot_idx >= 1 && slot_idx <= 64 && (play_state & 4)) ? (
    rb_base = 20000 + (slot_idx - 1) * 2048;
    cur_tok = floor(gmem[1009] + 0.5);
    gmem[rb_base + 2] != cur_tok ? (
      gmem[rb_base + 0] = 0;
      gmem[rb_base + 2] = cur_tok;
    );
    wseq = floor(gmem[rb_base + 0] + 0.5);
    ent = rb_base + 4 + ((wseq & 255) * 4);
    ev_qn = beat_position + (offset / cur_srate) * (cur_bpm / 60.0);
    gmem[ent + 0] = m1;
    gmem[ent + 1] = m2;
    gmem[ent + 2] = m3;
    gmem[ent + 3] = ev_qn;
    gmem[rb_base + 0] = wseq + 1;
  );
);

function is_rank_playable(pitch, k) local(base, min_p, max_p, r_strict) (
  base = 1010 + (k - 1) * 8;
  min_p = gmem[base + 0];
  max_p = gmem[base + 1];
  r_strict = gmem[base + 7];
  (min_p <= 0 && max_p <= 0) ? 1 : (
    (r_strict > 0.5 && (pitch < min_p || pitch > max_p)) ? 0 : 1;
  );
);

function is_any_rank_playable(pitch, M_cnt) local(k, ok) (
  ok = 0;
  k = 1;
  loop(M_cnt,
    is_rank_playable(pitch, k) ? ok = 1;
    k += 1;
  );
  ok;
);

function is_my_pitch_playable(pitch) (
  (my_strict > 0.5 && (pitch < my_min_p || pitch > my_max_p)) ? 0 : 1;
);

function clear_pitch_ranks(p) local(k, row) (
  primary_rank[p] = 0;
  row = p * STRIDE;
  k = 1;
  loop(64,
    assigned_map[row + k] = 0;
    is_fill_map[row + k] = 0;
    k += 1;
  );
);

function set_pitch_rank(p, k, is_fill) local(row) (
  (k >= 1 && k <= 64 && is_rank_playable(p, k)) ? (
    row = p * STRIDE;
    assigned_map[row + k] = 1;
    is_fill_map[row + k] = is_fill ? 1 : 0;
    (!is_fill || primary_rank[p] <= 0) ? (
      primary_rank[p] = k;
    );
  );
);

function reset_all_divisi_state(offset) local(p) (
  p = 0;
  loop(128,
    my_sounding[p] ? (
      emit_midi(offset, 0x80 | my_sounding_chan[p], p, 0);
      my_sounding[p] = 0;
    );
    kb_held[p] = 0;
    clear_pitch_ranks(p);
    preempted_rank[p] = 0;
    is_legato_tail[p] = 0;
    p += 1;
  );
  prev_single_k = 0;
  prev_single_pitch = -1;
  gliss_dir = 0;
  prev_melody_pitch = -1;
  last_fast_melody_sample = -10000000;
);

function single_note_cost(pitch, k, is_solo) local(base, min_p, max_p, center_p, is_prim, trk_mode, r_strict, dist, out_pen, sust_pen, cross_pen, k2, sp, lead_bonus, step_diff, step_abs, dt_sec, res) (
  !is_rank_playable(pitch, k) ? (
    res = UNPLAYABLE_COST;
  ) : (
    base = 1010 + (k - 1) * 8;
    min_p = gmem[base + 0];
    max_p = gmem[base + 1];
    center_p = gmem[base + 2];
    is_prim = gmem[base + 3];
    trk_mode = floor(gmem[base + 4] + 0.5);
    (min_p <= 0 && max_p <= 0) ? (
      min_p = 36; max_p = 84; center_p = 60; is_prim = 1; trk_mode = 0;
    );
    dist = abs(pitch - center_p);
    out_pen = 0;
    pitch < min_p ? (
      out_pen = 42.0 + (min_p - pitch) * 3.5;
    ) : (
      pitch > max_p ? (
        out_pen = 42.0 + (pitch - max_p) * 3.5;
      );
    );
    sust_pen = is_sustained[k] ? 100000.0 : 0.0;

    cross_pen = 0.0;
    k2 = 1;
    loop(M,
      (k2 != k && is_sustained[k2]) ? (
        sp = sust_pitch[k2];
        sp >= 0 ? (
          (k2 < k && pitch > sp) ? (
            cross_pen += 500.0 + (pitch - sp) * 10.0;
          ) : (
            (k2 > k && pitch < sp) ? (
              cross_pen += 500.0 + (sp - pitch) * 10.0;
            );
          );
        );
      );
      k2 += 1;
    );

    lead_bonus = 0.0;
    is_solo ? (
      is_prim ? ( lead_bonus -= 1.5; );
      (prev_single_k >= 1 && prev_single_pitch >= 0) ? (
        step_diff = pitch - prev_single_pitch;
        step_abs = abs(step_diff);
        dt_sec = (ev_sample - prev_single_sample) / max(1000.0, srate);
        (step_abs <= 5 && dt_sec <= 1.25) ? (
          (k == prev_single_k && out_pen == 0 && dist <= 9.5 && !is_sustained[k]) ? (
            lead_bonus -= 4.2;
          ) : (step_diff > 0 && k == prev_single_k - 1 && out_pen == 0 && !is_sustained[k]) ? (
            lead_bonus -= 3.2;
          ) : (step_diff < 0 && k == prev_single_k + 1 && out_pen == 0 && !is_sustained[k]) ? (
            lead_bonus -= 3.2;
          );
          (gliss_dir > 0 && step_diff > 0 && k > prev_single_k) ? (
            lead_bonus += 28.0;
          ) : (gliss_dir < 0 && step_diff < 0 && k < prev_single_k) ? (
            lead_bonus += 28.0;
          );
        );
      );
    );
    res = dist + out_pen + sust_pen + cross_pen + lead_bonus;
  );
  res;
);

function chord_note_cost(note_idx, N, pitch, k) local(base_c, base, center_p, dist, trk_mode, t_ord, b_ord, total_t, total_b, is_mixed, bottom_note_idx) (
  base_c = single_note_cost(pitch, k, 0);
  base_c < VALID_LIMIT ? (
    base = 1010 + (k - 1) * 8;
    center_p = gmem[base + 2];
    dist = abs(pitch - center_p);
    trk_mode = floor(gmem[base + 4] + 0.5);
    t_ord = floor(gmem[base + 5] + 0.5);
    b_ord = floor(gmem[base + 6] + 0.5);
    total_t = floor(gmem[1004] + 0.5);
    total_b = floor(gmem[1005] + 0.5);
    is_mixed = (total_t < M && total_b < M);
    bottom_note_idx = N - 1 - note_idx;

    trk_mode == 1 ? (
      t_ord >= 1 ? (
        (t_ord == 1 || !is_mixed || dist <= 8.0) ? (
          note_idx == (t_ord - 1) ? (
            base_c -= 38.0;
          ) : (
            base_c += abs(note_idx - (t_ord - 1)) * 22.0;
          );
        );
      );
    ) : (trk_mode == 2) ? (
      b_ord >= 1 ? (
        (b_ord == 1 || !is_mixed || dist <= 8.0) ? (
          bottom_note_idx == (b_ord - 1) ? (
            base_c -= 38.0;
          ) : (
            base_c += abs(bottom_note_idx - (b_ord - 1)) * 22.0;
          );
        );
      );
    );
  );
  base_c;
);

function fill_note_cost(note_idx, N, pitch, k) local(base_c, base, min_p, max_p, center_p, dist, trk_mode, t_ord, b_ord, total_t, total_b, is_mixed, bottom_note_idx, target_idx, target_b, max_mt, max_mb) (
  base_c = single_note_cost(pitch, k, 0);
  base_c < VALID_LIMIT ? (
    base = 1010 + (k - 1) * 8;
    min_p = gmem[base + 0];
    max_p = gmem[base + 1];
    center_p = gmem[base + 2];
    (min_p <= 0 && max_p <= 0) ? (
      min_p = 36; max_p = 84; center_p = 60;
    );
    dist = abs(pitch - center_p);
    trk_mode = floor(gmem[base + 4] + 0.5);
    t_ord = floor(gmem[base + 5] + 0.5);
    b_ord = floor(gmem[base + 6] + 0.5);
    total_t = floor(gmem[1004] + 0.5);
    total_b = floor(gmem[1005] + 0.5);
    is_mixed = (total_t < M && total_b < M);
    bottom_note_idx = N - 1 - note_idx;

    (N >= 2 && trk_mode == 0 && pitch < (min_p - 2) && cluster_notes[0] >= (min_p - 2)) ? (
      base_c += 90.0 + ((min_p - 2) - pitch) * 4.0;
    );

    trk_mode == 1 ? (
      t_ord >= 1 ? (
        target_idx = min(t_ord, N) - 1;
        max_mt = max(1, N - (total_b > 0 ? 1 : 0));
        (!is_mixed || t_ord == 1 || (t_ord <= max_mt && dist <= 8.0)) ? (
          note_idx == target_idx ? (
            base_c -= 38.0;
          ) : (
            base_c += abs(note_idx - target_idx) * 22.0;
          );
        );
      );
    ) : (trk_mode == 2) ? (
      b_ord >= 1 ? (
        target_b = min(b_ord, N) - 1;
        max_mb = max(1, N - (total_t > 0 ? 1 : 0));
        (!is_mixed || b_ord == 1 || (b_ord <= max_mb && dist <= 8.0)) ? (
          bottom_note_idx == target_b ? (
            base_c -= 38.0;
          ) : (
            base_c += abs(bottom_note_idx - target_b) * 22.0;
          );
        );
      );
    );

    (cluster_is_held[note_idx] && prev_assigned[note_idx * STRIDE + k]) ? (
      (pitch >= min_p && pitch <= max_p && dist <= 10.5) ? (
        base_c -= 3.5;
      );
    ) : (!cluster_is_held[note_idx] && pitch >= min_p && pitch <= max_p && dist <= 9.5) ? (
      base_c -= 2.5;
    );
  );
  base_c;
);

function assign_cluster_fill_all(N, M) local(M_elig, k, i, can_any, p0, best_k, best_cost, er, ek, c_val, step_diff, r, min_i, max_i, p_cur, p_prev, pitch_gap, base_c, trk_m, dup_adj, step_adj, cand, cur_i, prev_er, rem_notes, min_er, max_allowed_er, best_er, best_c, best_pk, best_pc, best_i) (
  // Collect ranks 1..M that can play at least one active cluster pitch
  M_elig = 0;
  k = 1;
  loop(M,
    can_any = 0;
    i = 0;
    loop(N,
      is_rank_playable(cluster_notes[i], k) ? can_any = 1;
      i += 1;
    );
    can_any ? (
      elig_ranks[M_elig] = k;
      M_elig += 1;
    );
    k += 1;
  );

  M_elig > 0 ? (
    N == 1 ? (
      p0 = cluster_notes[0];
      best_k = elig_ranks[0];
      best_cost = INF_COST;
      er = 0;
      loop(M_elig,
        ek = elig_ranks[er];
        c_val = single_note_cost(p0, ek, 1);
        c_val < best_cost ? (
          best_cost = c_val;
          best_k = ek;
        );
        er += 1;
      );
      best_cost < VALID_LIMIT ? (
        set_pitch_rank(p0, best_k, 0);
        er = 0;
        loop(M_elig,
          ek = elig_ranks[er];
          ek != best_k ? set_pitch_rank(p0, ek, 1);
          er += 1;
        );
        prev_single_pitch >= 0 ? (
          step_diff = p0 - prev_single_pitch;
          (step_diff >= 1 && step_diff <= 5) ? ( gliss_dir = 1; )
          : (step_diff <= -1 && step_diff >= -5) ? ( gliss_dir = -1; )
          : (step_diff != 0) ? ( gliss_dir = 0; );
        );
        prev_single_k = best_k;
        prev_single_pitch = p0;
        prev_single_sample = ev_sample;
      );
    ) : (N <= M_elig) ? (
      r = 0;
      loop(M_elig,
        i = 0;
        loop(N,
          dp[r * STRIDE + i] = INF_COST;
          parent[r * STRIDE + i] = 0;
          i += 1;
        );
        r += 1;
      );
      dp[0 * STRIDE + 0] = fill_note_cost(0, N, cluster_notes[0], elig_ranks[0]);

      r = 1;
      loop(M_elig - 1,
        ek = elig_ranks[r];
        trk_m = floor(gmem[1010 + (ek - 1) * 8 + 4] + 0.5);
        min_i = max(0, (N - 1) - (M_elig - 1 - r));
        max_i = min(N - 1, r);
        max_i >= min_i ? (
          i = min_i;
          loop(max_i - min_i + 1,
            p_cur = cluster_notes[i];
            base_c = fill_note_cost(i, N, p_cur, ek);

            base_c < VALID_LIMIT ? (
              dp[(r - 1) * STRIDE + i] < VALID_LIMIT ? (
                dup_adj = 0.0;
                trk_m == 0 ? (
                  (i == 0 || i == N - 1) ? ( dup_adj -= 1.5; );
                  (r >= 2 && M_elig < 2 * N && parent[(r - 1) * STRIDE + i] == i) ? ( dup_adj += 6.5; );
                );
                cand = dp[(r - 1) * STRIDE + i] + base_c + dup_adj;
                cand < dp[r * STRIDE + i] ? (
                  dp[r * STRIDE + i] = cand;
                  parent[r * STRIDE + i] = i;
                );
              );

              (i >= 1 && dp[(r - 1) * STRIDE + (i - 1)] < VALID_LIMIT) ? (
                p_prev = cluster_notes[i - 1];
                pitch_gap = p_prev - p_cur;
                step_adj = pitch_gap <= 9 ? -3.0 : 0.0;
                cand = dp[(r - 1) * STRIDE + (i - 1)] + base_c + step_adj;
                cand < dp[r * STRIDE + i] ? (
                  dp[r * STRIDE + i] = cand;
                  parent[r * STRIDE + i] = i - 1;
                );
              );
            );

            i += 1;
          );
        );
        r += 1;
      );

      dp[(M_elig - 1) * STRIDE + (N - 1)] < VALID_LIMIT ? (
        cur_i = N - 1;
        r = M_elig - 1;
        loop(M_elig,
          chosen_slot[r] = cur_i;
          cur_i = parent[r * STRIDE + cur_i];
          cur_i < 0 ? cur_i = 0;
          r -= 1;
        );
      ) : (
        // Non-monotonic wide-compass fallback: each eligible rank picks its lowest-cost playable note
        r = 0;
        loop(M_elig,
          ek = elig_ranks[r];
          best_i = -1;
          best_c = INF_COST;
          i = 0;
          loop(N,
            c_val = fill_note_cost(i, N, cluster_notes[i], ek);
            c_val < best_c ? ( best_c = c_val; best_i = i; );
            i += 1;
          );
          chosen_slot[r] = best_c < VALID_LIMIT ? best_i : -1;
          r += 1;
        );
      );

      i = 0;
      loop(N,
        p_cur = cluster_notes[i];
        best_pk = 0;
        best_pc = INF_COST;
        r = 0;
        loop(M_elig,
          ek = elig_ranks[r];
          chosen_slot[r] == i ? (
            c_val = single_note_cost(p_cur, ek, 0);
            (cluster_is_held[i] && prev_assigned[i * STRIDE + ek]) ? ( c_val -= 3.5; );
            c_val < best_pc ? ( best_pc = c_val; best_pk = ek; );
          );
          r += 1;
        );
        r = 0;
        loop(M_elig,
          ek = elig_ranks[r];
          (chosen_slot[r] == i && best_pc < VALID_LIMIT) ? (
            set_pitch_rank(p_cur, ek, ek != best_pk);
          );
          r += 1;
        );
        i += 1;
      );
      prev_single_k = 0;
      gliss_dir = 0;
    ) : (
      // N > M_elig: Surjective monotonic non-decreasing assignment across eligible playable ranks
      prev_er = 0;
      i = 0;
      loop(N,
        p_cur = cluster_notes[i];
        rem_notes = N - 1 - i;
        min_er = i == 0 ? 0 : max(prev_er, M_elig - 1 - rem_notes);
        max_allowed_er = i == 0 ? 0 : min(M_elig - 1, prev_er + 1);
        max_allowed_er < min_er ? max_allowed_er = min_er;
        best_er = min_er;
        best_c = INF_COST;
        er = min_er;
        loop(max_allowed_er - min_er + 1,
          c_val = fill_note_cost(i, N, p_cur, elig_ranks[er]);
          c_val < best_c ? (
            best_c = c_val;
            best_er = er;
          );
          er += 1;
        );
        best_c >= VALID_LIMIT ? (
          er = 0;
          loop(M_elig,
            c_val = fill_note_cost(i, N, p_cur, elig_ranks[er]);
            c_val < best_c ? (
              best_c = c_val;
              best_er = er;
            );
            er += 1;
          );
        );
        best_c < VALID_LIMIT ? (
          prev_er = best_er;
          set_pitch_rank(p_cur, elig_ranks[best_er], 0);
        );
        i += 1;
      );
      prev_single_k = 0;
      gliss_dir = 0;
    );
  );
);

function recompute_fill_all_state(ev_sample, is_note_off) local(p, k, row, lowest_held, highest_held, total_held, span_held, has_split_hands, melody_floor, focus_p, focus_onset, upper_held_cnt, in_fast_melody, N, yielded, dt_attack, dist_focus, is_older_held, was_any, k_min_p) (
  p = 0;
  loop(128,
    row = p * STRIDE;
    k = 1;
    loop(M,
      was_assigned[row + k] = assigned_map[row + k];
      assigned_map[row + k] = 0;
      is_fill_map[row + k] = 0;
      k += 1;
    );
    primary_rank[p] = 0;
    p += 1;
  );

  lowest_held = 999;
  highest_held = -1;
  total_held = 0;
  p = 0;
  loop(128,
    (kb_held[p] && is_any_rank_playable(p, M)) ? (
      p < lowest_held ? lowest_held = p;
      p > highest_held ? highest_held = p;
      total_held += 1;
    );
    p += 1;
  );

  total_held > 0 ? (
    span_held = highest_held - lowest_held;
    has_split_hands = (total_held >= 2 && span_held >= 7);
    melody_floor = has_split_hands ? (span_held >= 15 ? (lowest_held + 8) : (lowest_held + 4)) : 48;

    focus_p = -1;
    focus_onset = -1000000000;
    upper_held_cnt = 0;
    p = 0;
    loop(128,
      (kb_held[p] && p >= melody_floor && is_any_rank_playable(p, M)) ? (
        upper_held_cnt += 1;
        kb_onset[p] >= focus_onset ? (
          focus_onset = kb_onset[p];
          focus_p = p;
        );
      );
      p += 1;
    );

    in_fast_melody = ((ev_sample - last_fast_melody_sample) <= (0.65 * cur_srate));

    N = 0;
    p = 127;
    loop(128,
      (kb_held[p] && N < 64 && is_any_rank_playable(p, M)) ? (
        yielded = 0;
        (focus_p >= 0 && p != focus_p && p >= melody_floor) ? (
          dt_attack = focus_onset - kb_onset[p];
          dist_focus = abs(p - focus_p);
          dist_focus <= 2 ? (
            has_split_hands ? (
              dt_attack >= (0.014 * cur_srate) ? yielded = 1;
            ) : (
              (upper_held_cnt <= 3 && dt_attack >= (0.025 * cur_srate)) ? yielded = 1;
            );
          ) : (dist_focus <= 5) ? (
            (has_split_hands && in_fast_melody && dt_attack >= (0.014 * cur_srate)) ? (
              yielded = 1;
            ) : (upper_held_cnt == 2 && dt_attack > chord_window_samples && (ev_sample - focus_onset) <= (0.40 * cur_srate)) ? (
              yielded = 1;
            );
          );
        );

        !yielded ? (
          was_any = 0;
          row = p * STRIDE;
          k = 1;
          loop(M,
            was_assigned[row + k] ? was_any = 1;
            k += 1;
          );
          is_older_held = ((ev_sample - kb_onset[p]) > chord_window_samples) || (is_note_off && was_any);
          cluster_notes[N] = p;
          cluster_is_held[N] = is_older_held ? 1 : 0;
          k = 1;
          loop(M,
            prev_assigned[N * STRIDE + k] = is_older_held ? was_assigned[row + k] : 0;
            k += 1;
          );
          N += 1;
        );
      );
      p -= 1;
    );

    N > 0 ? (
      assign_cluster_fill_all(N, M);

      is_note_off ? (
        p = 0;
        loop(128,
          kb_held[p] ? (
            row = p * STRIDE;
            k = 1;
            loop(M,
              (assigned_map[row + k] && is_fill_map[row + k] && !was_assigned[row + k]) ? (
                k_min_p = gmem[1010 + (k - 1) * 8 + 0];
                k_min_p <= 0 ? k_min_p = 36;
                p < (k_min_p - 3) ? (
                  assigned_map[row + k] = 0;
                  is_fill_map[row + k] = 0;
                );
              );
              k += 1;
            );
          );
          p += 1;
        );
      );
    );
  );
);

function assign_cluster(N, M, mode) local(p0, best_k, best_cost, k, c_val, i, p_cur, p_prev, pitch_gap, max_k, base_c, prev_k, step_adj, cand, best_last_k, best_total, cur_k, rem_notes, min_rem, max_allowed_k, best_c, step_diff) (
  N == 1 ? (
    p0 = cluster_notes[0];
    best_k = 1;
    best_cost = INF_COST;
    k = 1;
    loop(M,
      c_val = single_note_cost(p0, k, 1);
      c_val < best_cost ? (
        best_cost = c_val;
        best_k = k;
      );
      k += 1;
    );
    best_cost < VALID_LIMIT ? (
      set_pitch_rank(p0, best_k, 0);
      prev_single_pitch >= 0 ? (
        step_diff = p0 - prev_single_pitch;
        (step_diff >= 1 && step_diff <= 5) ? ( gliss_dir = 1; )
        : (step_diff <= -1 && step_diff >= -5) ? ( gliss_dir = -1; )
        : (step_diff != 0) ? ( gliss_dir = 0; );
      );
      prev_single_k = best_k;
      prev_single_pitch = p0;
      prev_single_sample = ev_sample;
    );
  ) : (N <= M) ? (
    i = 0;
    loop(N,
      k = 1;
      loop(M,
        dp[i * STRIDE + k] = INF_COST;
        parent[i * STRIDE + k] = 1;
        k += 1;
      );
      i += 1;
    );
    k = 1;
    loop(M - N + 1,
      dp[0 * STRIDE + k] = chord_note_cost(0, N, cluster_notes[0], k);
      k += 1;
    );
    i = 1;
    loop(N - 1,
      p_cur = cluster_notes[i];
      p_prev = cluster_notes[i - 1];
      pitch_gap = p_prev - p_cur;
      k = i + 1;
      max_k = M - (N - 1 - i);
      loop(max_k - k + 1,
        base_c = chord_note_cost(i, N, p_cur, k);
        base_c < VALID_LIMIT ? (
          prev_k = i;
          loop(k - i,
            dp[(i - 1) * STRIDE + prev_k] < VALID_LIMIT ? (
              step_adj = 0.0;
              (pitch_gap <= 9 && k == prev_k + 1) ? (
                step_adj = -4.5;
              ) : (
                (pitch_gap >= 14 && k == prev_k + 1 && M > N) ? (
                  step_adj = 2.5;
                );
              );
              cand = dp[(i - 1) * STRIDE + prev_k] + base_c + step_adj;
              cand < dp[i * STRIDE + k] ? (
                dp[i * STRIDE + k] = cand;
                parent[i * STRIDE + k] = prev_k;
              );
            );
            prev_k += 1;
          );
        );
        k += 1;
      );
      i += 1;
    );
    best_last_k = N;
    best_total = INF_COST;
    k = N;
    loop(M - N + 1,
      dp[(N - 1) * STRIDE + k] < best_total ? (
        best_total = dp[(N - 1) * STRIDE + k];
        best_last_k = k;
      );
      k += 1;
    );
    best_total < VALID_LIMIT ? (
      cur_k = best_last_k;
      i = N - 1;
      loop(N,
        p_cur = cluster_notes[i];
        set_pitch_rank(p_cur, cur_k, 0);
        cur_k = parent[i * STRIDE + cur_k];
        cur_k < 1 ? cur_k = 1;
        i -= 1;
      );
    ) : (
      k = 1;
      loop(M, used_rank_tmp[k] = 0; k += 1; );
      i = 0;
      loop(N,
        p_cur = cluster_notes[i];
        best_k = 0;
        best_c = INF_COST;
        k = 1;
        loop(M,
          !used_rank_tmp[k] ? (
            c_val = chord_note_cost(i, N, p_cur, k);
            c_val < best_c ? ( best_c = c_val; best_k = k; );
          );
          k += 1;
        );
        best_c >= VALID_LIMIT ? (
          k = 1;
          loop(M,
            c_val = chord_note_cost(i, N, p_cur, k);
            c_val < best_c ? ( best_c = c_val; best_k = k; );
            k += 1;
          );
        );
        best_c < VALID_LIMIT && best_k >= 1 ? (
          used_rank_tmp[best_k] = 1;
          set_pitch_rank(p_cur, best_k, 0);
        );
        i += 1;
      );
    );
    prev_single_k = 0;
    gliss_dir = 0;
  ) : (
    prev_k = 1;
    i = 0;
    loop(N,
      p_cur = cluster_notes[i];
      rem_notes = N - 1 - i;
      min_rem = M - prev_k;
      rem_notes < min_rem ? min_rem = rem_notes;
      max_allowed_k = M - min_rem;
      max_allowed_k < prev_k ? max_allowed_k = prev_k;
      best_k = prev_k;
      best_c = INF_COST;
      k = prev_k;
      loop(max_allowed_k - prev_k + 1,
        c_val = chord_note_cost(i, N, p_cur, k);
        c_val < best_c ? (
          best_c = c_val;
          best_k = k;
        );
        k += 1;
      );
      best_c >= VALID_LIMIT ? (
        k = 1;
        loop(M,
          c_val = chord_note_cost(i, N, p_cur, k);
          c_val < best_c ? (
            best_c = c_val;
            best_k = k;
          );
          k += 1;
        );
      );
      best_c < VALID_LIMIT ? (
        prev_k = best_k;
        set_pitch_rank(p_cur, best_k, 0);
      );
      i += 1;
    );
    prev_single_k = 0;
    gliss_dir = 0;
  );
);

function reconcile_my_output(offset, reattack_pitch) local(p, assigned_to_me) (
  // 1. Send Note-Off FIRST for any pitch on this track that was released, or moved off my_rank
  p = 0;
  loop(128,
    my_sounding[p] ? (
      assigned_to_me = assigned_map[p * STRIDE + my_rank];
      (!kb_held[p] || (!assigned_to_me && !is_legato_tail[p])) ? (
        emit_midi(offset, 0x80 | my_sounding_chan[p], p, 0);
        my_sounding[p] = 0;
        is_legato_tail[p] = 0;
      );
    );
    p += 1;
  );

  // 2. Send Note-On for any playable pitch now assigned to this track
  p = 0;
  loop(128,
    (kb_held[p] && assigned_map[p * STRIDE + my_rank] && is_my_pitch_playable(p)) ? (
      !my_sounding[p] ? (
        emit_midi(offset, 0x90 | kb_chan[p], p, kb_vel[p]);
        my_sounding[p] = 1;
        my_sounding_chan[p] = kb_chan[p];
      ) : (p == reattack_pitch) ? (
        emit_midi(offset, 0x80 | my_sounding_chan[p], p, 0);
        emit_midi(offset, 0x90 | kb_chan[p], p, kb_vel[p]);
        my_sounding_chan[p] = kb_chan[p];
      );
    );
    p += 1;
  );
);

@block
gmem[1007] = 262;
my_rank = max(1, floor(slider1 + 0.5));
M = gmem[1000] > 0 ? floor(gmem[1000] + 0.5) : max(1, floor(slider2 + 0.5));
mode = gmem[1000] > 0 ? floor(gmem[1001] + 0.5) : floor(slider3 + 0.5);
tol_ticks = gmem[1002] > 0 ? gmem[1002] : slider4;
enabled = (slider5 > 0.5) && (gmem[1000] > 0 ? (gmem[1003] > 0.5) : 1);
fill_all = gmem[1000] > 0 ? (gmem[1006] > 0.5) : (slider6 > 0.5);
slot_idx = floor(slider7 + 0.5);
my_min_p = floor(slider8 + 0.5);
my_max_p = floor(slider9 + 0.5);
my_max_p <= 0 ? my_max_p = 127;
my_strict = slider10 > 0.5 ? 1 : 0;

cur_bpm = tempo > 10 ? tempo : 120;
cur_srate = srate > 1000 ? srate : 48000;
tol_samples = (tol_ticks / 960.0) * (60.0 / cur_bpm) * cur_srate;
chord_window_samples = max(tol_samples * 1.45, 0.036 * cur_srate);
gliss_legato_window_samples = max(chord_window_samples * 2.0, 0.65 * cur_srate);

while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;
  chan = msg1 & 0x0F;
  pitch = msg2 & 0x7F;
  vel = msg3 & 0x7F;
  ev_sample = running_samples + offset;

  (status == 0xB0 && (pitch == 120 || pitch == 123)) ? (
    reset_all_divisi_state(offset);
    emit_midi(offset, msg1, msg2, msg3);
  ) : (!enabled || M <= 1 || (status != 0x90 && status != 0x80)) ? (
    (status == 0x80 || (status == 0x90 && vel == 0)) ? (
      kb_held[pitch] = 0;
      clear_pitch_ranks(pitch);
      preempted_rank[pitch] = 0;
      is_legato_tail[pitch] = 0;
      (my_sounding[pitch] || is_my_pitch_playable(pitch)) ? (
        emit_midi(offset, msg1, msg2, msg3);
      );
      my_sounding[pitch] = 0;
    ) : (status == 0x90 && vel > 0) ? (
      is_my_pitch_playable(pitch) ? (
        my_sounding[pitch] = 1;
        my_sounding_chan[pitch] = chan;
        emit_midi(offset, msg1, msg2, msg3);
      );
    ) : (
      emit_midi(offset, msg1, msg2, msg3);
    );
  ) : (
    (status == 0x80 || (status == 0x90 && vel == 0)) ? (
      freed_rank = primary_rank[pitch];
      kb_held[pitch] = 0;
      preempted_rank[pitch] = 0;
      is_legato_tail[pitch] = 0;

      fill_all ? (
        k = 1;
        loop(M + 2,
          is_sustained[k] = 0;
          sust_pitch[k] = -1;
          k += 1;
        );
        recompute_fill_all_state(ev_sample, 1);
      ) : (
        clear_pitch_ranks(pitch);
        (freed_rank >= 1 && freed_rank <= M) ? (
          rank_busy = 0;
          p = 0;
          loop(128,
            (kb_held[p] && assigned_map[p * STRIDE + freed_rank]) ? rank_busy = 1;
            p += 1;
          );
          !rank_busy ? (
            best_wait_p = -1;
            best_wait_dist = INF_COST;
            p = 0;
            loop(128,
              (kb_held[p] && primary_rank[p] == 0 && !is_legato_tail[p] && is_rank_playable(p, freed_rank)) ? (
                w_dist = abs(p - pitch);
                preempted_rank[p] == freed_rank ? ( w_dist -= 1000.0; );
                w_dist < best_wait_dist ? (
                  best_wait_dist = w_dist;
                  best_wait_p = p;
                );
              );
              p += 1;
            );
            best_wait_p >= 0 ? (
              set_pitch_rank(best_wait_p, freed_rank, 0);
              preempted_rank[best_wait_p] = 0;
            );
          );
        );
      );

      reconcile_my_output(offset, -1);
    ) : (
      // Note-On (vel > 0)
      kb_held[pitch] = 1;
      kb_vel[pitch] = vel;
      kb_chan[pitch] = chan;
      kb_onset[pitch] = ev_sample;
      preempted_rank[pitch] = 0;
      is_legato_tail[pitch] = 0;

      pitch >= 44 ? (
        prev_melody_pitch >= 44 ? (
          mel_step = abs(pitch - prev_melody_pitch);
          mel_dt = ev_sample - prev_melody_sample;
          (mel_step >= 1 && mel_step <= 5 && mel_dt >= (0.012 * cur_srate) && mel_dt <= (0.65 * cur_srate)) ? (
            last_fast_melody_sample = ev_sample;
          );
        );
        prev_melody_pitch = pitch;
        prev_melody_sample = ev_sample;
      );

      k = 1;
      loop(M + 2,
        is_sustained[k] = 0;
        sust_pitch[k] = -1;
        k += 1;
      );

      fill_all ? (
        recompute_fill_all_state(ev_sample, 0);
      ) : (
        // Standard Auto-Divisi Mode (1-to-1 voice routing inside playable instrument compasses)
        clear_pitch_ranks(pitch);
        sust_cnt = 0;
        N = 0;
        p = 127;
        loop(128,
          (kb_held[p] && is_any_rank_playable(p, M)) ? (
            rk = primary_rank[p];
            ((ev_sample - kb_onset[p]) > chord_window_samples && rk >= 1 && rk <= M) ? (
              (p != pitch && abs(pitch - p) <= 4 && (ev_sample - kb_onset[p]) <= gliss_legato_window_samples && is_rank_playable(pitch, rk)) ? (
                is_legato_tail[p] = 1;
                clear_pitch_ranks(p);
                preempted_rank[p] = rk;
              ) : (
                !is_sustained[rk] ? (
                  is_sustained[rk] = 1;
                  sust_pitch[rk] = p;
                  sust_cnt += 1;
                ) : (
                  clear_pitch_ranks(p);
                  preempted_rank[p] = rk;
                );
              );
            ) : (
              (preempted_rank[p] == 0 && !is_legato_tail[p] && N < 64) ? (
                clear_pitch_ranks(p);
                cluster_notes[N] = p;
                N += 1;
              );
            );
          );
          p -= 1;
        );

        ni = 0;
        loop(N,
          (sust_cnt > 0 && (sust_cnt + N) > M) ? (
            p_new = cluster_notes[ni];
            best_rep_k = 0;
            best_rep_cost = INF_COST;
            k = 1;
            loop(M,
              (is_sustained[k] && is_rank_playable(p_new, k)) ? (
                p_old = sust_pitch[k];
                rep_c = abs(p_new - p_old);
                k2 = 1;
                loop(M,
                  (k2 != k && is_sustained[k2]) ? (
                    sp2 = sust_pitch[k2];
                    (k2 < k && p_new > sp2) ? ( rep_c += 500.0 + (p_new - sp2) * 10.0; );
                    (k2 > k && p_new < sp2) ? ( rep_c += 500.0 + (sp2 - p_new) * 10.0; );
                  );
                  k2 += 1;
                );
                rep_c < best_rep_cost ? (
                  best_rep_cost = rep_c;
                  best_rep_k = k;
                );
              );
              k += 1;
            );
            best_rep_k >= 1 ? (
              p_pre = sust_pitch[best_rep_k];
              p_pre >= 0 ? (
                clear_pitch_ranks(p_pre);
                preempted_rank[p_pre] = best_rep_k;
              );
              is_sustained[best_rep_k] = 0;
              sust_pitch[best_rep_k] = -1;
              sust_cnt -= 1;
            );
          );
          ni += 1;
        );

        N > 0 ? (
          assign_cluster(N, M, mode);
          i = 0;
          loop(N,
            cp = cluster_notes[i];
            rk = primary_rank[cp];
            (rk >= 1 && rk <= M) ? (
              sust_pitch[rk] >= 0 && sust_pitch[rk] != cp ? (
                p_pre = sust_pitch[rk];
                clear_pitch_ranks(p_pre);
                preempted_rank[p_pre] = rk;
                is_legato_tail[p_pre] = 0;
                is_sustained[rk] = 0;
                sust_pitch[rk] = -1;
              );
              p = 0;
              loop(128,
                (p != cp && is_legato_tail[p] && preempted_rank[p] == rk) ? (
                  is_legato_tail[p] = 0;
                );
                p += 1;
              );
            );
            i += 1;
          );
        );
      );

      reconcile_my_output(offset, pitch);
    );
  );
);

running_samples += samplesblock;
